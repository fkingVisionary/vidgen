# ─────────────────────────────────────────────────────────────────────────────
# Documentary Engine — environment variables
# Copy to .env for local development:  cp .env.example .env
# On Railway, set these in the service's Variables tab (never commit secrets).
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Railway injects PORT automatically.
PORT=3000
HOST=0.0.0.0
# trace | debug | info | warn | error
LOG_LEVEL=info

# ── Database (PostgreSQL 16+) ────────────────────────────────────────────────
# Local default matches docker-compose.yml. On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://docengine:docengine@localhost:5432/docengine
DATABASE_POOL_SIZE=10
# Integration tests only. The database name MUST contain "test" (tables are truncated).
TEST_DATABASE_URL=postgresql://docengine:docengine@localhost:5432/docengine_test

# ── Dashboard access ─────────────────────────────────────────────────────────
# HTTP Basic auth for the dashboard and API (/api/health stays public for
# Railway's health check). REQUIRED when NODE_ENV=production; optional locally.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ── Job worker ───────────────────────────────────────────────────────────────
# Runs inside the API process in V1. Set false if you run `pnpm start:worker` separately.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
# A RUNNING job whose worker has been silent this long is assumed dead and retried.
JOB_LOCK_TIMEOUT_MS=900000

# ── Provider selection ───────────────────────────────────────────────────────
# Implemented: AI=mock|anthropic, RESEARCH=mock|tavily; every other slot is
# mock-only for now. An unimplemented value fails at startup with a clear
# "not implemented yet" error.
# The real RESEARCH stage runs only when AI and RESEARCH are both real
# (AI_PROVIDER=anthropic + RESEARCH_PROVIDER=tavily); otherwise it is the
# MOCK placeholder. GET /api/health lists the real stages ("realStages").
# Also implemented: VOICE=elevenlabs, STORAGE=s3 (a Railway bucket, Cloudflare
# R2, AWS S3, MinIO); real narration needs both.
# Planned: RESEARCH=exa|anthropic-web-search, VIDEO=higgsfield,
# RENDER=ffmpeg (+ Remotion for infographics), PUBLISHING=youtube.
AI_PROVIDER=mock
RESEARCH_PROVIDER=mock
VOICE_PROVIDER=mock
VIDEO_PROVIDER=mock
STORAGE_PROVIDER=mock
RENDER_PROVIDER=mock
PUBLISHING_PROVIDER=mock

# ── Provider credentials ─────────────────────────────────────────────────────
# Read server-side only; never sent to the dashboard. Set them in Railway's
# Variables tab (or your local .env), never in code or chat.

# Anthropic (AI_PROVIDER=anthropic). Model used for every research task;
# costs are estimated from the served model's published per-token prices.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Tavily (RESEARCH_PROVIDER=tavily): web search + full-text extraction.
TAVILY_API_KEY=
# api-key (default) or keyless (Tavily's free, rate-limited access; no key, $0).
TAVILY_ACCESS_MODE=api-key
# Your plan's price per API credit, used to estimate cost (Tavily reports
# credits, not dollars). 0.008 = pay-as-you-go list price; set yours.
TAVILY_USD_PER_CREDIT=0.008

# ── Research stage limits ────────────────────────────────────────────────────
# A run stops (job FAILED, nothing approved) once its recorded provider cost
# exceeds this many USD.
RESEARCH_MAX_COST_USD=40
# Upper bound of sources whose full text is retrieved and read per run.
RESEARCH_MAX_SOURCES=45

# ── Story stage (story mining + story architecture) ─────────────────────────
# Runs with the AI provider above (real when AI_PROVIDER=anthropic).
# Ceiling on one mining or architecture job's estimated spend (USD).
STORY_MAX_COST_USD=15

# ── Script stage (Script Engine 1.0) ─────────────────────────────────────────
# Runs with the AI provider above. Ceiling on one script job's estimated spend
# (USD): a draft, a section rewrite or a whole revision.
SCRIPT_MAX_COST_USD=15
# Optional per-step models, e.g. perform=<model id>,edit=<model id>
# (steps: plan, write, edit, factCheck, perform). Unset steps use AI_MODEL.
SCRIPT_MODELS=

# ── Voice (VOICE_PROVIDER=elevenlabs) ────────────────────────────────────────
# Narration is generated in small chunks through the Voice page. The voice id
# seeds the first voice profile (profiles are versioned in the dashboard).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Production default eleven_v4 (audio tags, no SSML); no automatic fallback.
ELEVENLABS_MODEL_ID=eleven_v4
# mp3_*, wav_* or pcm_* only (opus/µ-law cannot be measured or joined without transcoding).
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Optional: your plan's USD price per 1,000 characters (default: documented list price per model).
ELEVENLABS_USD_PER_1K_CHARS=
# Confirmation threshold, per-job ceiling and parallel takes.
VOICE_CONFIRM_CHARACTERS=3000
VOICE_MAX_CHARACTERS=40000
VOICE_CONCURRENCY=2

# ── Planned providers (NOT USED YET) ─────────────────────────────────────────

# Higgsfield (exact credential format to be confirmed when the integration is built)
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# S3-compatible object storage (STORAGE_PROVIDER=s3) — required for real narration.
# On Railway reference a bucket's ENDPOINT, REGION, BUCKET, ACCESS_KEY_ID, SECRET_ACCESS_KEY.
# For Cloudflare R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com  S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SEC=3600

# YouTube Data API (OAuth refresh token for the channel)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
