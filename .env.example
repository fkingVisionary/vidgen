# ─────────────────────────────────────────────────────────────────────────────
# Documentary Engine — environment variables
# Copy to .env for local development:  cp .env.example .env
# On Railway, set these in the service's Variables tab (never commit secrets).
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Railway injects PORT automatically.
PORT=3000
HOST=0.0.0.0
# trace | debug | info | warn | error
LOG_LEVEL=info

# ── Database (PostgreSQL 16+) ────────────────────────────────────────────────
# Local default matches docker-compose.yml. On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://docengine:docengine@localhost:5432/docengine
DATABASE_POOL_SIZE=10
# Integration tests only. The database name MUST contain "test" (tables are truncated).
TEST_DATABASE_URL=postgresql://docengine:docengine@localhost:5432/docengine_test

# ── Dashboard access ─────────────────────────────────────────────────────────
# HTTP Basic auth for the dashboard and API (/api/health stays public for
# Railway's health check). REQUIRED when NODE_ENV=production; optional locally.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ── Job worker ───────────────────────────────────────────────────────────────
# Runs inside the API process in V1. Set false if you run `pnpm start:worker` separately.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
# A RUNNING job whose worker has been silent this long is assumed dead and retried.
JOB_LOCK_TIMEOUT_MS=900000

# ── Provider selection ───────────────────────────────────────────────────────
# V1 implements ONLY "mock" for every slot. Any other value fails at startup
# with a clear "not implemented yet" error. Real providers arrive in later
# milestones.
# Planned values: AI=anthropic, RESEARCH=anthropic-web-search|exa|tavily,
# VOICE=elevenlabs, VIDEO=higgsfield, STORAGE=s3 (Cloudflare R2 / AWS S3 / MinIO),
# RENDER=ffmpeg (+ Remotion for infographics), PUBLISHING=youtube.
AI_PROVIDER=mock
RESEARCH_PROVIDER=mock
VOICE_PROVIDER=mock
VIDEO_PROVIDER=mock
STORAGE_PROVIDER=mock
RENDER_PROVIDER=mock
PUBLISHING_PROVIDER=mock

# ── Provider credentials (NOT USED YET — planned milestones) ─────────────────
# Read server-side only; never exposed to the dashboard.

# LLM
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ElevenLabs. Voice IDs are chosen per project/language (LanguageVersion.voiceConfig),
# never hard-coded. The default below is only a fallback for new language versions.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=
ELEVENLABS_DEFAULT_VOICE_ID=

# Higgsfield (exact credential format to be confirmed when the integration is built)
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# S3-compatible object storage. For Cloudflare R2:
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com   S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_TTL_SEC=3600

# YouTube Data API (OAuth refresh token for the channel)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
