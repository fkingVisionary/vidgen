{
  "name": "@docengine/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP API, dashboard host and (embedded) job worker.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "node build.mjs",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "research": "tsx src/research-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@docengine/core": "workspace:*",
    "@docengine/database": "workspace:*",
    "@docengine/pipeline": "workspace:*",
    "@docengine/providers": "workspace:*",
    "@docengine/research": "workspace:*",
    "@docengine/script": "workspace:*",
    "@docengine/story": "workspace:*",
    "@docengine/storyboard": "workspace:*",
    "@docengine/voice": "workspace:*",
    "@docengine/writing": "workspace:*",
    "@fastify/static": "10.1.5",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "fastify": "5.12.5",
    "pg": "catalog:",
    "pino": "10.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "pino-pretty": "13.1.3"
  }
}
