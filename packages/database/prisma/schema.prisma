// ─────────────────────────────────────────────────────────────────────────────
// Project spine
// ─────────────────────────────────────────────────────────────────────────────

/// A documentary episode. `status` is the master pipeline phase (see packages/core/src/pipeline.ts).
model Project {
  id               String         @id @default(uuid(7)) @db.Uuid
  slug             String         @unique
  title            String
  workingTitle     String?        @map("working_title")
  topic            String
  description      String?
  category         String?
  style            String?
  targetMinutesMin Int            @default(10) @map("target_minutes_min")
  targetMinutesMax Int            @default(15) @map("target_minutes_max")
  /// Language the master story is written and approved in. Its LanguageVersion is the master.
  masterLanguage   String         @default("en") @map("master_language")
  status           ProjectStatus  @default(IDEA)
  /// Set while status = FAILED: the status the project failed in (bounds recovery/rewind).
  failedFromStatus ProjectStatus? @map("failed_from_status")
  /// Incremented each time a new phase run starts. Jobs are stamped with it; only jobs of the
  /// current run count towards completing a phase.
  phaseSeq         Int            @default(0) @map("phase_seq")
  statusChangedAt  DateTime       @default(now()) @map("status_changed_at") @db.Timestamptz(3)
  /// Planning estimate for the whole episode. Actual cost is summed from provider_calls.
  estimatedCostUsd Decimal?       @map("estimated_cost_usd") @db.Decimal(14, 6)
  metadata         Json           @default("{}")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  languageVersions     LanguageVersion[]
  jobs                 Job[]
  approvals            Approval[]
  events               ProjectEvent[]
  providerCalls        ProviderCall[]
  assets               MediaAsset[]
  sources              Source[]
  dossiers             ResearchDossier[]
  storyPacks           StoryPack[]
  storyCandidates      StoryCandidate[]
  stories              StoryArchitecture[]
  contentOpportunities ContentOpportunity[]
  storyExplorations    StoryExploration[]
  scripts              Script[]
  voiceRuns            VoiceRun[]
  voicePronunciations  VoicePronunciation[]
  writingExamples      WritingExample[]
  storyboards          Storyboard[]
  infographics         Infographic[]
  timelines            Timeline[]
  renders              Render[]
  qaReports            QaReport[]

  @@index([status])
  @@map("projects")
}

/// One localized edition of a project. Owns everything that differs per language:
/// narration, subtitles, timeline timing, renders, metadata and publishing state.
model LanguageVersion {
  id              String                @id @default(uuid(7)) @db.Uuid
  projectId       String                @map("project_id") @db.Uuid
  /// Code from SUPPORTED_LANGUAGES (en, es, fr, de, it, pt, ja, ko).
  language        String
  status          LanguageVersionStatus @default(PLANNED)
  /// VoiceSettings contract (provider, voiceId, model, stability, similarity, style, speed).
  voiceConfig     Json?                 @map("voice_config")
  /// Localized publishing metadata (title, description, tags, chapters).
  metadata        Json                  @default("{}")
  platformVideoId String?               @map("platform_video_id")
  publishedUrl    String?               @map("published_url")
  publishedAt     DateTime?             @map("published_at") @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobs          Job[]
  narrations    SceneNarration[]
  voiceRuns     VoiceRun[]
  timelines     Timeline[]
  renders       Render[]
  assets        MediaAsset[]
  providerCalls ProviderCall[]
  approvals     Approval[]
  qaReports     QaReport[]

  @@unique([projectId, language])
  @@map("language_versions")
}

/// A unit of pipeline work. The table doubles as the V1 job queue
/// (claimed with SELECT … FOR UPDATE SKIP LOCKED).
model Job {
  id                String    @id @default(uuid(7)) @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  languageVersionId String?   @map("language_version_id") @db.Uuid
  type              JobType
  status            JobStatus @default(QUEUED)
  /// Project.phaseSeq at enqueue time.
  phaseSeq          Int       @map("phase_seq")
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3) @map("max_attempts")
  /// Not claimable before this time (retry backoff).
  runAfter          DateTime  @default(now()) @map("run_after") @db.Timestamptz(3)
  lockedAt          DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy          String?   @map("locked_by")
  startedAt         DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  /// True if any provider used by the job was a MOCK.
  isMock            Boolean   @default(false) @map("is_mock")
  input             Json      @default("{}")
  result            Json?
  /// Saved progress of a long job (e.g. research phase outputs). An automatic
  /// or manual retry resumes from it instead of repeating paid provider calls.
  checkpoint        Json?
  error             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  languageVersion   LanguageVersion?    @relation(fields: [languageVersionId], references: [id], onDelete: SetNull)
  providerCalls     ProviderCall[]
  events            ProjectEvent[]
  dossiers          ResearchDossier[]
  storyPacks        StoryPack[]
  stories           StoryArchitecture[]
  storyExplorations StoryExploration[]
  scripts           Script[]
  voiceGenerations  VoiceGeneration[]

  @@index([status, runAfter])
  @@index([projectId, type, status])
  @@map("jobs")
}

/// A recorded human decision at an approval gate. Optional FKs point at the exact artifact version reviewed.
model Approval {
  id                String           @id @default(uuid(7)) @db.Uuid
  projectId         String           @map("project_id") @db.Uuid
  languageVersionId String?          @map("language_version_id") @db.Uuid
  gate              ApprovalGate
  decision          ApprovalDecision
  notes             String?
  decidedBy         String?          @map("decided_by")
  /// Project status when the decision was made.
  projectStatus     ProjectStatus    @map("project_status")
  dossierId         String?          @map("dossier_id") @db.Uuid
  storyId           String?          @map("story_id") @db.Uuid
  scriptId          String?          @map("script_id") @db.Uuid
  voiceAssemblyId   String?          @map("voice_assembly_id") @db.Uuid
  storyboardId      String?          @map("storyboard_id") @db.Uuid
  renderId          String?          @map("render_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  languageVersion LanguageVersion?   @relation(fields: [languageVersionId], references: [id], onDelete: SetNull)
  dossier         ResearchDossier?   @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  story           StoryArchitecture? @relation(fields: [storyId], references: [id], onDelete: SetNull)
  script          Script?            @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  voiceAssembly   VoiceAssembly?     @relation(fields: [voiceAssemblyId], references: [id], onDelete: SetNull)
  storyboard      Storyboard?        @relation(fields: [storyboardId], references: [id], onDelete: SetNull)
  render          Render?            @relation(fields: [renderId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("approvals")
}

/// Append-only audit/activity log: status changes, jobs, approvals.
model ProjectEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  jobId     String?  @map("job_id") @db.Uuid
  /// e.g. STATUS_CHANGED, JOB_QUEUED, JOB_SUCCEEDED, JOB_RETRY_SCHEDULED, JOB_FAILED, APPROVAL_RECORDED
  type      String
  message   String
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job     Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("project_events")
}

/// Ledger of every external provider invocation: observability, cost tracking,
/// and the lifecycle of async generations (provider job id → status → asset).
/// A failed shot is retried by creating a new call for the same shot.
model ProviderCall {
  id                String             @id @default(uuid(7)) @db.Uuid
  projectId         String?            @map("project_id") @db.Uuid
  jobId             String?            @map("job_id") @db.Uuid
  languageVersionId String?            @map("language_version_id") @db.Uuid
  shotId            String?            @map("shot_id") @db.Uuid
  kind              ProviderKind
  provider          String
  operation         String
  model             String?
  isMock            Boolean            @default(false) @map("is_mock")
  status            ProviderCallStatus @default(PENDING)
  /// Vendor-side id for async work (e.g. a video generation).
  providerJobId     String?            @map("provider_job_id")
  /// Vendor request id (support tickets, debugging).
  providerRequestId String?            @map("provider_request_id")
  /// Request summary (prompt, parameters). Never contains credentials.
  request           Json?
  response          Json?
  error             String?
  /// UsageItem[] (tokens, characters, seconds…).
  usage             Json               @default("[]")
  estimatedCostUsd  Decimal?           @map("estimated_cost_usd") @db.Decimal(14, 6)
  actualCostUsd     Decimal?           @map("actual_cost_usd") @db.Decimal(14, 6)
  /// Where the cost figure comes from: the vendor, our rate card (estimate), nowhere (unpriced) or a mock.
  costBasis         CostBasis?         @map("cost_basis")
  costNote          String?            @map("cost_note")
  outputAssetId     String?            @map("output_asset_id") @db.Uuid
  startedAt         DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz(3)
  durationMs        Int?               @map("duration_ms")

  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job             Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  languageVersion LanguageVersion? @relation(fields: [languageVersionId], references: [id], onDelete: SetNull)
  shot            Shot?            @relation(fields: [shotId], references: [id], onDelete: SetNull)
  outputAsset     MediaAsset?      @relation(fields: [outputAssetId], references: [id], onDelete: SetNull)
  voiceGeneration VoiceGeneration?

  @@index([projectId])
  @@index([jobId])
  @@index([provider, providerJobId])
  @@map("provider_calls")
}

/// Any stored file: narration audio, images, clips, infographic renders, music, SFX,
/// subtitles (SRT/VTT), final renders. Bytes live in object storage under `storage_key`.
/// language_version_id = null means language-neutral (reusable across languages).
model MediaAsset {
  id                String    @id @default(uuid(7)) @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  languageVersionId String?   @map("language_version_id") @db.Uuid
  kind              AssetKind
  storageKey        String    @unique @map("storage_key")
  mimeType          String    @map("mime_type")
  sizeBytes         BigInt?   @map("size_bytes")
  durationMs        Int?      @map("duration_ms")
  width             Int?
  height            Int?
  checksumSha256    String?   @map("checksum_sha256")
  provider          String?
  isMock            Boolean   @default(false) @map("is_mock")
  /// Kind-specific details: subtitle format, licence/attribution for music & SFX, etc.
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  languageVersion  LanguageVersion? @relation(fields: [languageVersionId], references: [id], onDelete: Cascade)
  narration        SceneNarration?
  voiceGeneration  VoiceGeneration?
  voiceAssembly    VoiceAssembly?
  selectedForShots Shot[]
  producedBy       ProviderCall[]
  infographics     Infographic[]
  renderOutputs    Render[]

  @@index([projectId, kind])
  @@map("media_assets")
}

// ─────────────────────────────────────────────────────────────────────────────
// Research
// ─────────────────────────────────────────────────────────────────────────────

model Source {
  id               String           @id @default(uuid(7)) @db.Uuid
  projectId        String           @map("project_id") @db.Uuid
  sourceType       SourceType       @map("source_type")
  title            String
  author           String?
  publisher        String?
  /// Free-form because historical dates are messy ("1637", "c. 1841").
  publishedDate    String?          @map("published_date")
  url              String?
  /// Canonical form of `url` used for de-duplication (no fragment, tracking params, trailing slash; lower-case host).
  normalizedUrl    String?          @map("normalized_url")
  domain           String?
  /// Full formatted citation.
  citation         String
  reliability      ConfidenceLevel?
  reliabilityNotes String?          @map("reliability_notes")
  notes            String?
  /// Whether the full text was retrieved. Only retrieved sources can back claims.
  retrievalStatus  RetrievalStatus  @default(PENDING) @map("retrieval_status")
  retrievalError   String?          @map("retrieval_error")
  /// Search-engine snippet: used for triage only, never as evidence.
  searchSnippet    String?          @map("search_snippet")
  searchScore      Float?           @map("search_score")
  /// Research questions / queries that surfaced this source.
  discoveredBy     Json             @default("[]") @map("discovered_by")
  /// Set when this source's content duplicates another (mirror, syndicated copy).
  duplicateOfId    String?          @map("duplicate_of_id") @db.Uuid
  accessedAt       DateTime?        @map("accessed_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  citations   ClaimCitation[]
  document    SourceDocument?
  duplicateOf Source?         @relation("SourceDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  Source[]        @relation("SourceDuplicates")

  @@unique([projectId, normalizedUrl])
  @@index([projectId])
  @@map("sources")
}

/// Retrieved full text of a source, plus the cached per-source evidence analysis.
model SourceDocument {
  id              String    @id @default(uuid(7)) @db.Uuid
  sourceId        String    @unique @map("source_id") @db.Uuid
  provider        String
  contentFormat   String    @map("content_format")
  text            String
  chars           Int
  sha256          String
  fetchedAt       DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(3)
  /// Evidence notes and source assessment produced by the reading pass (cached across research runs).
  analysis        Json?
  analysisVersion String?   @map("analysis_version")
  analyzedAt      DateTime? @map("analyzed_at") @db.Timestamptz(3)

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sha256])
  @@map("source_documents")
}

/// A versioned research dossier (human approval gate #1 reviews one version).
model ResearchDossier {
  id            String         @id @default(uuid(7)) @db.Uuid
  projectId     String         @map("project_id") @db.Uuid
  version       Int
  status        ArtifactStatus @default(DRAFT)
  summary       String?
  /// ResearchDossierContent contract: questions, timeline, prices, myths, interpretations, open questions…
  content       Json           @default("{}")
  /// QualityReport contract: automated checks run before human review.
  qualityReport Json?          @map("quality_report")
  qualityPassed Boolean?       @map("quality_passed")
  /// Model(s) and prompt version that produced it, search/retrieval statistics.
  stats         Json           @default("{}")
  jobId         String?        @map("job_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job                  Job?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)
  claims               ResearchClaim[]
  storyPacks           StoryPack[]
  storyCandidates      StoryCandidate[]
  stories              StoryArchitecture[]
  contentOpportunities ContentOpportunity[]
  approvals            Approval[]

  @@unique([projectId, version])
  @@map("research_dossiers")
}

/// One factual claim and where it stands against the evidence.
/// `verdict` separates WHAT WE KNOW from WHAT IS COMMONLY CLAIMED.
model ResearchClaim {
  id                String          @id @default(uuid(7)) @db.Uuid
  dossierId         String          @map("dossier_id") @db.Uuid
  /// Stable key within the dossier ("C014"), referenced by timeline/myth/price sections.
  claimKey          String          @map("claim_key")
  /// Research question / theme the claim answers (chronology, prices, …).
  category          String?
  importance        ClaimImportance @default(SUPPORTING)
  statement         String
  claimType         ClaimType       @map("claim_type")
  verdict           ClaimVerdict    @default(UNVERIFIED)
  confidence        ConfidenceLevel @default(LOW)
  needsVerification Boolean         @default(true) @map("needs_verification")
  /// The popular version of the story this claim corrects, if any.
  popularVersion    String?         @map("popular_version")
  notes             String?
  sortOrder         Int             @default(0) @map("sort_order")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  dossier              ResearchDossier           @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  citations            ClaimCitation[]
  storyCandidates      StoryCandidateClaim[]
  contentOpportunities ContentOpportunityClaim[]
  scriptBlocks         ScriptBlockClaim[]

  @@unique([dossierId, claimKey])
  @@index([dossierId])
  @@map("research_claims")
}

/// Claim ↔ source link. A claim can be supported by one source and contradicted by another.
model ClaimCitation {
  id            String         @id @default(uuid(7)) @db.Uuid
  claimId       String         @map("claim_id") @db.Uuid
  sourceId      String         @map("source_id") @db.Uuid
  stance        CitationStance @default(SUPPORTS)
  /// FULL_TEXT: quote taken from the retrieved document. SNIPPET: only a search snippet (never sufficient for key claims).
  basis         CitationBasis  @default(FULL_TEXT)
  /// Page, folio, timestamp or anchor.
  locator       String?
  quote         String?
  /// True when `quote` was found verbatim in the retrieved document text.
  quoteVerified Boolean        @default(false) @map("quote_verified")
  /// Evidence note this citation came from (reading pass), for traceability.
  evidenceKey   String?        @map("evidence_key")
  notes         String?

  claim  ResearchClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  source Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([sourceId])
  @@map("claim_citations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Story & script
// ─────────────────────────────────────────────────────────────────────────────

/// One story-mining pass over an approved research dossier: a ranked pool of
/// story candidates plus the proposed selection for the documentary. Another
/// pass creates a new version; candidates the editor approved or flagged are
/// carried over into it.
model StoryPack {
  id            String         @id @default(uuid(7)) @db.Uuid
  projectId     String         @map("project_id") @db.Uuid
  /// The approved research dossier version that was mined.
  dossierId     String         @map("dossier_id") @db.Uuid
  version       Int
  /// Story engine that mined the pack (1: milestone 3, 2: Story Engine 2.0). Older rows are 1.
  engineVersion Int            @default(1) @map("engine_version")
  status        ArtifactStatus @default(DRAFT)
  /// StoryPackContent contract: the selection proposal, candidates removed by the rules and why, editor brief.
  content       Json           @default("{}")
  /// QualityReport contract: the mining gate.
  qualityReport Json?          @map("quality_report")
  qualityPassed Boolean?       @map("quality_passed")
  /// Model(s), prompt version, counts, duration.
  stats         Json           @default("{}")
  /// The editor's instructions for this mining pass.
  notes         String?
  jobId         String?        @map("job_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dossier       ResearchDossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  job           Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  candidates    StoryCandidate[]
  architectures StoryArchitecture[]
  explorations  StoryExploration[]

  @@unique([projectId, version])
  @@map("story_packs")
}

/// A story unit found in the dossier — characters, desire, conflict, stakes,
/// escalation, turning point, payoff — scored, ranked and traced to the claims
/// it is built on. Its historical status and confidence are computed from
/// those claims' verdicts, never chosen by the model. The editorial fields
/// (status, selected, priority, editor notes) are set by a human.
model StoryCandidate {
  id                   String               @id @default(uuid(7)) @db.Uuid
  packId               String               @map("pack_id") @db.Uuid
  projectId            String               @map("project_id") @db.Uuid
  dossierId            String               @map("dossier_id") @db.Uuid
  /// Stable key within the pack ("S07"), in rank order at creation.
  candidateKey         String               @map("candidate_key")
  title                String
  /// One-sentence hook.
  hook                 String
  storyType            StoryType            @map("story_type")
  /// StoryCharacter[] contract: name, kind (named person, group, role), role in the story, claim keys.
  characters           Json                 @default("[]")
  setting              String
  timePeriod           String               @map("time_period")
  desire               String
  conflict             String
  stakes               String
  escalation           String
  turningPoint         String               @map("turning_point")
  payoff               String
  whyInteresting       String               @map("why_interesting")
  /// The question this story makes the viewer want answered.
  viewerQuestion       String               @map("viewer_question")
  /// MythThread contract, for units built on a myth: popular story → origin → who spread it → what happened → why it survived.
  mythThread           Json?                @map("myth_thread")
  /// StoryScores contract: component scores (0–10) and the critic's rationale.
  scores               Json
  historicalStatus     HistoricalStatus     @map("historical_status")
  /// 0–10, from the verdicts and confidence of the linked claims and the number of sources behind them.
  historicalConfidence Int                  @map("historical_confidence")
  /// Appeal weighted by historical confidence (see packages/core/src/story.ts).
  rankScore            Float                @map("rank_score")
  /// Position in the pack by rank score when it was mined (1 = best).
  rank                 Int
  /// Caveats the telling must respect (disputed figures, uncertain dates, critic's notes).
  notes                String?
  /// Part of the AI's proposed selection (kept to compare with the editor's choice).
  aiSelected           Boolean              @default(false) @map("ai_selected")
  aiSelectionReason    String?              @map("ai_selection_reason")
  status               CandidateStatus      @default(PROPOSED)
  /// In the editor's selection for the documentary.
  selected             Boolean              @default(false)
  priority             CandidatePriority    @default(NORMAL)
  editorNotes          String?              @map("editor_notes")
  // Story Engine 2.0 (null on engine-1 candidates)
  /// The AI's suggested narrative mode (the editor's choice is in editor_overrides).
  narrativeMode        NarrativeMode?       @map("narrative_mode")
  /// The AI's suggested central question.
  centralQuestion      String?              @map("central_question")
  /// PovChoice contract: the AI's suggested point-of-view strategy.
  povStrategy          Json?                @map("pov_strategy")
  /// HumanStakes contract: protagonist, could gain, could lose, immediate problem.
  humanStakes          Json?                @map("human_stakes")
  /// StoryDesign contract: labelled cold open, reveal, visual environment, human story found.
  storyDesign          Json?                @map("story_design")
  reconstructionLevel  ReconstructionLevel? @map("reconstruction_level")
  /// STORY VALUE and HISTORICAL VALUE, 0–10 (rank_score is then STORY APPEAL).
  storyValue           Float?               @map("story_value")
  historicalValue      Float?               @map("historical_value")
  /// CandidateOverrides contract: the editor's title, narrative mode, central question, POV strategy.
  editorOverrides      Json?                @map("editor_overrides")
  /// The editor's order of the selection (1 = first).
  selectionOrder       Int?                 @map("selection_order")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  pack    StoryPack             @relation(fields: [packId], references: [id], onDelete: Cascade)
  project Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dossier ResearchDossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  claims  StoryCandidateClaim[]

  @@unique([packId, candidateKey])
  @@index([packId, rank])
  @@map("story_candidates")
}

/// Candidate ↔ dossier claim. A candidate's sources are the sources cited by its claims.
model StoryCandidateClaim {
  candidateId String @map("candidate_id") @db.Uuid
  claimId     String @map("claim_id") @db.Uuid

  candidate StoryCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  claim     ResearchClaim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@id([candidateId, claimId])
  @@index([claimId])
  @@map("story_candidate_claims")
}

/// The documentary blueprint built from the editor's selection (human approval gate #2):
/// premise, central question, narrative spine and sequences. Not a script.
model StoryArchitecture {
  id                   String         @id @default(uuid(7)) @db.Uuid
  projectId            String         @map("project_id") @db.Uuid
  /// Research dossier version this story was built on.
  dossierId            String?        @map("dossier_id") @db.Uuid
  /// Story pack whose selected candidates it was built from.
  packId               String?        @map("pack_id") @db.Uuid
  version              Int
  /// Story engine that built it (1: milestone 3, 2: Story Engine 2.0). Older rows are 1.
  engineVersion        Int            @default(1) @map("engine_version")
  status               ArtifactStatus @default(DRAFT)
  /// StoryArchitectureContent contract (engine 1) or StoryArchitectureContentV2 (engine 2).
  content              Json
  targetDurationSec    Int?           @map("target_duration_sec")
  estimatedDurationSec Int?           @map("estimated_duration_sec")
  /// QualityReport contract: the architecture gate.
  qualityReport        Json?          @map("quality_report")
  qualityPassed        Boolean?       @map("quality_passed")
  stats                Json           @default("{}")
  /// The editor's instructions for this version (rework notes, or the brief of a revision).
  notes                String?
  /// The version this one revises (kept unchanged); null when built from the selection.
  revisionOfId         String?        @map("revision_of_id") @db.Uuid
  /// The exploration whose angle it was built on or revised toward, and the angle's key ("A2").
  explorationId        String?        @map("exploration_id") @db.Uuid
  angleKey             String?        @map("angle_key")
  jobId                String?        @map("job_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dossier              ResearchDossier?     @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  pack                 StoryPack?           @relation(fields: [packId], references: [id], onDelete: SetNull)
  job                  Job?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)
  revisionOf           StoryArchitecture?   @relation("ArchitectureRevisions", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions            StoryArchitecture[]  @relation("ArchitectureRevisions")
  exploration          StoryExploration?    @relation("ArchitectureAngle", fields: [explorationId], references: [id], onDelete: SetNull)
  explorationsOf       StoryExploration[]   @relation("ExplorationBase")
  scripts              Script[]
  approvals            Approval[]
  contentOpportunities ContentOpportunity[]

  @@unique([projectId, version])
  @@index([revisionOfId])
  @@map("story_architectures")
}

/// Alternative narrative angles explored from one story pack (a STORY_ANGLES side job): 2–3
/// materially different approaches to the same curated units, compared before committing to one.
/// Evidence-bound (the pack's units and their claims); not an architecture, approves nothing.
model StoryExploration {
  id                    String   @id @default(uuid(7)) @db.Uuid
  projectId             String   @map("project_id") @db.Uuid
  /// The story pack whose units the angles use (its dossier is the evidence).
  packId                String   @map("pack_id") @db.Uuid
  version               Int
  /// Explored as alternatives to this architecture version.
  basedOnArchitectureId String?  @map("based_on_architecture_id") @db.Uuid
  /// StoryExplorationContent contract: the angles, angles the rules removed and why, comparisons.
  content               Json
  /// QualityReport contract: angle count, distinctness, evidence.
  qualityReport         Json?    @map("quality_report")
  qualityPassed         Boolean  @default(false) @map("quality_passed")
  stats                 Json     @default("{}")
  /// The editor's brief for the exploration.
  notes                 String?
  jobId                 String?  @map("job_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pack          StoryPack           @relation(fields: [packId], references: [id], onDelete: Cascade)
  basedOn       StoryArchitecture?  @relation("ExplorationBase", fields: [basedOnArchitectureId], references: [id], onDelete: SetNull)
  job           Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  architectures StoryArchitecture[] @relation("ArchitectureAngle")

  @@unique([projectId, version])
  @@map("story_explorations")
}

/// A content opportunity found in a story architecture: a structured brief for a future
/// long-form or short-form production. Never a script, voice, video or export.
model ContentOpportunity {
  id                   String            @id @default(uuid(7)) @db.Uuid
  projectId            String            @map("project_id") @db.Uuid
  architectureId       String            @map("architecture_id") @db.Uuid
  /// The approved research dossier the architecture was built on.
  dossierId            String            @map("dossier_id") @db.Uuid
  /// Stable key within the architecture ("O01"): shorts by rank, then long-form.
  opportunityKey       String            @map("opportunity_key")
  format               ContentFormat
  status               OpportunityStatus @default(PROPOSED)
  /// Rank among SHORT and BOTH opportunities by short-form potential (1 = best); null for LONG_FORM.
  rank                 Int?
  /// SHORT-FORM POTENTIAL, 0–10.
  shortScore           Float?            @map("short_score")
  title                String
  hook                 String
  centralQuestion      String            @map("central_question")
  targetDurationSec    Int?              @map("target_duration_sec")
  /// Understandable without the long-form documentary.
  independent          Boolean
  requiresContext      Boolean           @map("requires_context")
  historicalStatus     HistoricalStatus  @map("historical_status")
  historicalConfidence Int               @map("historical_confidence")
  /// ContentOpportunityContent contract: premise, angle, escalation, payoff, ending, visual concept,
  /// source beats, sequences and units, claim keys, sources, presentation instructions, scores.
  content              Json
  editorNotes          String?           @map("editor_notes")
  decidedBy            String?           @map("decided_by")
  decidedAt            DateTime?         @map("decided_at") @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  project      Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  architecture StoryArchitecture         @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  dossier      ResearchDossier           @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  claims       ContentOpportunityClaim[]

  @@unique([architectureId, opportunityKey])
  @@index([projectId, status])
  @@map("content_opportunities")
}

/// The approved dossier claims a content opportunity rests on.
model ContentOpportunityClaim {
  opportunityId String @map("opportunity_id") @db.Uuid
  claimId       String @map("claim_id") @db.Uuid

  opportunity ContentOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  claim       ResearchClaim      @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@id([opportunityId, claimId])
  @@index([claimId])
  @@map("content_opportunity_claims")
}

/// Language-neutral script structure (scenes). The words live in SceneNarration, per language.
/// Script Engine 1.0 writes one version per draft, rewrite or restore; versions are never changed
/// once superseded or approved.
model Script {
  id                   String         @id @default(uuid(7)) @db.Uuid
  projectId            String         @map("project_id") @db.Uuid
  /// The approved story architecture the script tells.
  storyId              String?        @map("story_id") @db.Uuid
  version              Int
  status               ArtifactStatus @default(DRAFT)
  title                String?
  estimatedDurationSec Int?           @map("estimated_duration_sec")
  /// Script QA scores (NARRATIVE_SCORE, AUDIO_FLOW_SCORE, …): the script editor's, 0–10.
  scores               Json?
  /// The editor's brief or instructions for this version.
  notes                String?
  /// 1 = Script Engine 1.0.
  engineVersion        Int            @default(1) @map("engine_version")
  /// ScriptContent: narrator, central question, pronunciations, reviewers, provenance.
  content              Json?
  qualityReport        Json?          @map("quality_report")
  qualityPassed        Boolean        @default(false) @map("quality_passed")
  stats                Json           @default("{}")
  targetDurationSec    Int?           @map("target_duration_sec")
  wordCount            Int?           @map("word_count")
  /// The version this one was made from (it is kept unchanged).
  revisionOfId         String?        @map("revision_of_id") @db.Uuid
  jobId                String?        @map("job_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story           StoryArchitecture? @relation(fields: [storyId], references: [id], onDelete: SetNull)
  revisionOf      Script?            @relation("ScriptRevisions", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions       Script[]           @relation("ScriptRevisions")
  job             Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  scenes          Scene[]
  blocks          ScriptBlock[]
  voiceRuns       VoiceRun[]
  storyboards     Storyboard[]
  approvals       Approval[]
  writingExamples WritingExample[]

  @@unique([projectId, version])
  @@index([revisionOfId])
  @@map("scripts")
}

model Scene {
  id                     String              @id @default(uuid(7)) @db.Uuid
  scriptId               String              @map("script_id") @db.Uuid
  /// Stable key shared by every language ("S01").
  sceneKey               String              @map("scene_key")
  sortOrder              Int                 @map("sort_order")
  title                  String?
  emotionalTone          String?             @map("emotional_tone")
  visualIntent           String?             @map("visual_intent")
  infographicOpportunity String?             @map("infographic_opportunity")
  soundDesignOpportunity String?             @map("sound_design_opportunity")
  targetDurationSec      Float?              @map("target_duration_sec")
  /// The architecture sequence this section tells (Script Engine: one section per sequence).
  sequenceNumber         Int?                @map("sequence_number")
  /// The planner's intent for the section (ScriptSectionPlan).
  content                Json?
  reviewStatus           SectionReviewStatus @default(PENDING) @map("review_status")
  editorNotes            String?             @map("editor_notes")
  reviewedBy             String?             @map("reviewed_by")
  reviewedAt             DateTime?           @map("reviewed_at") @db.Timestamptz(3)

  script       Script           @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  narrations   SceneNarration[]
  shots        Shot[]
  infographics Infographic[]

  @@unique([scriptId, sceneKey])
  @@index([scriptId, sortOrder])
  @@map("scenes")
}

/// The spoken words of one scene in one language, plus its generated audio and timing.
model SceneNarration {
  id                   String         @id @default(uuid(7)) @db.Uuid
  sceneId              String         @map("scene_id") @db.Uuid
  languageVersionId    String         @map("language_version_id") @db.Uuid
  status               ArtifactStatus @default(DRAFT)
  text                 String
  wordCount            Int            @map("word_count")
  estimatedDurationSec Float?         @map("estimated_duration_sec")
  audioAssetId         String?        @unique @map("audio_asset_id") @db.Uuid
  audioDurationMs      Int?           @map("audio_duration_ms")
  /// Word/character timestamps from the voice provider (drives subtitles and the edit).
  alignment            Json?
  /// Snapshot of the VoiceSettings used to generate the audio.
  voiceSettings        Json?          @map("voice_settings")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  scene           Scene           @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  languageVersion LanguageVersion @relation(fields: [languageVersionId], references: [id], onDelete: Cascade)
  audioAsset      MediaAsset?     @relation(fields: [audioAssetId], references: [id], onDelete: SetNull)
  blocks          ScriptBlock[]

  @@unique([sceneId, languageVersionId])
  @@map("scene_narrations")
}

/// One unit of narration in one language: a few spoken sentences with one information class,
/// traced to the architecture beats it realises and the approved claims it rests on, with its
/// delivery (pace, energy, emotion, emphasis, pauses) and the visual intent handed to the storyboard.
model ScriptBlock {
  id                   String           @id @default(uuid(7)) @db.Uuid
  scriptId             String           @map("script_id") @db.Uuid
  narrationId          String           @map("narration_id") @db.Uuid
  /// "<sequence>.<n>", stable within a version.
  blockKey             String           @map("block_key")
  sortOrder            Int              @map("sort_order")
  text                 String
  /// The text as generated for this version (kept when the editor changes it).
  generatedText        String           @map("generated_text")
  infoClass            ScriptBlockClass @map("info_class")
  /// Architecture beats this block realises ("3.2").
  beatIds              String[]         @map("beat_ids")
  /// Cast id of the speaker (null = the narrator).
  speakerId            String?          @map("speaker_id")
  /// RECORDED_QUOTE or INVENTED for a cast member's words.
  speechKind           String?          @map("speech_kind")
  /// A fictional device is in the block: downstream visuals must never present it as history.
  fictionalDevice      Boolean          @default(false) @map("fictional_device")
  /// ScriptDelivery: pace, energy, emotion, emphasis, pauses.
  delivery             Json
  /// ScriptVisual: intent, must show / avoid, priority.
  visual               Json
  /// BlockPresentation[]: how its claims that are not ESTABLISHED must be presented.
  presentation         Json             @default("[]")
  wordCount            Int              @map("word_count")
  estimatedDurationSec Float            @map("estimated_duration_sec")
  editedBy             String?          @map("edited_by")
  editedAt             DateTime?        @map("edited_at") @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  script    Script             @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  narration SceneNarration     @relation(fields: [narrationId], references: [id], onDelete: Cascade)
  claims    ScriptBlockClaim[]

  @@unique([narrationId, blockKey])
  @@index([narrationId, sortOrder])
  @@index([scriptId])
  @@map("script_blocks")
}

/// The approved claims a narration block rests on (FK: cannot dangle).
model ScriptBlockClaim {
  blockId String @map("block_id") @db.Uuid
  claimId String @map("claim_id") @db.Uuid

  block ScriptBlock   @relation(fields: [blockId], references: [id], onDelete: Cascade)
  claim ResearchClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@id([blockId, claimId])
  @@index([claimId])
  @@map("script_block_claims")
}

// ─────────────────────────────────────────────────────────────────────────────
// Voice
// ─────────────────────────────────────────────────────────────────────────────

/// A narrator: provider, voice, model, language, output format and everything else that shapes a take
/// (VoiceProfileConfig: voice settings, performance strategy, chunking, context, number style).
/// Never edited once created: a change is a new version, so every take keeps the exact profile it used.
model VoiceProfile {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Shared by every version ("House narrator").
  name         String
  version      Int
  provider     String
  voiceId      String   @map("voice_id")
  modelId      String   @map("model_id")
  language     String
  outputFormat String   @map("output_format")
  config       Json
  /// The profile new runs use (one active version per name).
  active       Boolean  @default(true)
  notes        String?
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  runs        VoiceRun[]
  generations VoiceGeneration[]
  assemblies  VoiceAssembly[]

  @@unique([name, version])
  @@map("voice_profiles")
}

/// One voice run ("Voice Run 3"): a scope of one approved script version narrated with one profile.
/// Its chunks are fixed when it is created; their takes, decisions and assemblies accumulate.
model VoiceRun {
  id                String              @id @default(uuid(7)) @db.Uuid
  projectId         String              @map("project_id") @db.Uuid
  languageVersionId String              @map("language_version_id") @db.Uuid
  scriptId          String              @map("script_id") @db.Uuid
  profileId         String              @map("profile_id") @db.Uuid
  /// Per project: Voice Run 1, 2, 3…
  number            Int
  kind              VoiceRunKind
  /// The VoiceScope asked for, and the block keys it resolved to.
  scope             Json
  strategy          PerformanceStrategy
  /// Chunking and context used (the profile's, with the run's overrides).
  settings          Json
  /// A comparison: runs narrating the same scope different ways share an experiment name and carry a variant label.
  experiment        String?
  variant           String?
  notes             String?
  createdBy         String?             @map("created_by")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  languageVersion LanguageVersion   @relation(fields: [languageVersionId], references: [id], onDelete: Cascade)
  script          Script            @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  profile         VoiceProfile      @relation(fields: [profileId], references: [id], onDelete: Restrict)
  chunks          VoiceChunk[]
  generations     VoiceGeneration[]
  assemblies      VoiceAssembly[]

  @@unique([projectId, number])
  @@index([scriptId])
  @@map("voice_runs")
}

/// A chunk of natural speech: whole sentences of one section, from one or more blocks (or part of one),
/// the smallest unit generated, reviewed and regenerated. The script's text is copied, never changed.
model VoiceChunk {
  id                  String   @id @default(uuid(7)) @db.Uuid
  runId               String   @map("run_id") @db.Uuid
  sceneId             String   @map("scene_id") @db.Uuid
  /// Order within the run (0-based).
  chunkIndex          Int      @map("chunk_index")
  sectionKey          String   @map("section_key")
  /// Blocks spoken, in order; the first is the chunk's source block.
  blockKeys           String[] @map("block_keys")
  sourceBlockId       String   @map("source_block_id") @db.Uuid
  /// ChunkSpan[]: block id/key and character range of each part.
  spans               Json
  /// The canonical text (the script's words, exactly).
  sourceText          String   @map("source_text")
  /// SHA-256 of sourceText: a take of other text is never reused silently.
  textHash            String   @map("text_hash")
  /// SHA-256 of each source block's whole text, keyed by block key (stale detection against later script versions).
  blockHashes         Json     @map("block_hashes")
  words               Int
  /// Why the chunk ends here (ChunkBoundary).
  boundary            String
  /// ChunkPerformance: the script's delivery for the chunk, and its pauses.
  performance         Json
  /// The take the assembly uses.
  currentGenerationId String?  @unique @map("current_generation_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  run         VoiceRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  generations VoiceGeneration[] @relation("ChunkGenerations")
  current     VoiceGeneration?  @relation("ChunkCurrent", fields: [currentGenerationId], references: [id], onDelete: SetNull)

  @@unique([runId, chunkIndex])
  @@map("voice_chunks")
}

/// One take of one chunk (Generation 1, 2, 3…): exactly what was sent, with what, what came back and what
/// the editor decided. Never deleted or overwritten; a newer current take supersedes the one before.
model VoiceGeneration {
  id                String                @id @default(uuid(7)) @db.Uuid
  chunkId           String                @map("chunk_id") @db.Uuid
  runId             String                @map("run_id") @db.Uuid
  projectId         String                @map("project_id") @db.Uuid
  jobId             String?               @map("job_id") @db.Uuid
  /// 1, 2, 3… per chunk.
  generation        Int
  status            VoiceGenerationStatus @default(PENDING)
  profileId         String                @map("profile_id") @db.Uuid
  provider          String
  model             String
  voiceId           String                @map("voice_id")
  strategy          PerformanceStrategy
  /// The script's words this take speaks, and their hash at generation time.
  canonicalText     String                @map("canonical_text")
  textHash          String                @map("text_hash")
  /// Derived: numbers, dates and aliases as spoken.
  spokenText        String?               @map("spoken_text")
  /// Derived: the exact text sent to the provider (spoken text plus its performance markup). Never the script.
  performanceText   String?               @map("performance_text")
  /// PreparedNarration: spoken forms, performance marks, pauses, context, settings, seed, dictionary, checks.
  prepared          Json?
  /// The editor's directions for this take (DirectorMark[]), if any.
  directions        Json?
  audioAssetId      String?               @unique @map("audio_asset_id") @db.Uuid
  durationMs        Int?                  @map("duration_ms")
  /// NarrationAlignment: word timings in the canonical text, and the provider's character timestamps.
  alignment         Json?
  /// VoiceQaFinding[] for this take.
  qa                Json?
  providerCallId    String?               @unique @map("provider_call_id") @db.Uuid
  providerRequestId String?               @map("provider_request_id")
  characters        Int?
  error             String?
  note              String?
  decidedBy         String?               @map("decided_by")
  decidedAt         DateTime?             @map("decided_at") @db.Timestamptz(3)
  /// Approved at some point (kept when the take is superseded, so restoring it restores the approval).
  approvedAt        DateTime?             @map("approved_at") @db.Timestamptz(3)
  createdBy         String?               @map("created_by")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt       DateTime?             @map("completed_at") @db.Timestamptz(3)

  chunk        VoiceChunk    @relation("ChunkGenerations", fields: [chunkId], references: [id], onDelete: Cascade)
  currentOf    VoiceChunk?   @relation("ChunkCurrent")
  run          VoiceRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  job          Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  profile      VoiceProfile  @relation(fields: [profileId], references: [id], onDelete: Restrict)
  audioAsset   MediaAsset?   @relation(fields: [audioAssetId], references: [id], onDelete: SetNull)
  providerCall ProviderCall? @relation(fields: [providerCallId], references: [id], onDelete: SetNull)

  @@unique([chunkId, generation])
  @@index([runId, status])
  @@map("voice_generations")
}

/// The assembled narration of a run: its current takes in order, where each starts and ends, the pauses
/// between them, and the narration timeline. A new version whenever a current take changes; the
/// approved full-script assembly is what the VOICE gate approves.
model VoiceAssembly {
  id              String         @id @default(uuid(7)) @db.Uuid
  runId           String         @map("run_id") @db.Uuid
  projectId       String         @map("project_id") @db.Uuid
  scriptId        String         @map("script_id") @db.Uuid
  profileId       String         @map("profile_id") @db.Uuid
  /// Per run.
  version         Int
  status          ArtifactStatus @default(DRAFT)
  /// AssemblyEntry[] in order.
  entries         Json
  /// NarrationTimelineEntry[]: block parts, words and visual hints on the assembled clock.
  timeline        Json
  totalDurationMs Int            @map("total_duration_ms")
  /// Covers every block of the script version.
  complete        Boolean        @default(false)
  /// VoiceQaFinding[] when it was assembled.
  qa              Json
  /// The assembled audio file, built on first request.
  audioAssetId    String?        @unique @map("audio_asset_id") @db.Uuid
  createdBy       String?        @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  run        VoiceRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  profile    VoiceProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  audioAsset MediaAsset?  @relation(fields: [audioAssetId], references: [id], onDelete: SetNull)
  approvals  Approval[]

  @@unique([runId, version])
  @@map("voice_assemblies")
}

/// The project's pronunciation review list: names, places, foreign words and abbreviations in the narration,
/// and how each is said. The script keeps the written form; aliases are spoken instead of it, phonemes go
/// to the provider's pronunciation dictionary.
model VoicePronunciation {
  id            String              @id @default(uuid(7)) @db.Uuid
  projectId     String              @map("project_id") @db.Uuid
  language      String
  term          String
  /// PronunciationTermKind.
  kind          String
  method        PronunciationMethod @default(DEFAULT)
  /// IPA / CMU phonemes, or the alias spoken instead (null for the voice's own reading).
  pronunciation String?
  status        PronunciationStatus @default(PENDING)
  /// SCRIPT (the script's pronunciation notes), DETECTED (found in the narration) or EDITOR.
  source        String
  /// The script's respelling hint ("YOHST van KOYK"), when it has one.
  hint          String?
  notes         String?
  updatedBy     String?             @map("updated_by")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, language, term])
  @@map("voice_pronunciations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Visuals
// ─────────────────────────────────────────────────────────────────────────────

/// Versioned visual plan for one script version (human approval gate #4).
model Storyboard {
  id        String         @id @default(uuid(7)) @db.Uuid
  projectId String         @map("project_id") @db.Uuid
  scriptId  String         @map("script_id") @db.Uuid
  version   Int
  status    ArtifactStatus @default(DRAFT)
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  script    Script     @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  shots     Shot[]
  approvals Approval[]
  timelines Timeline[]

  @@unique([projectId, version])
  @@map("storyboards")
}

/// One planned shot. Language-neutral, so generated visuals are reused by every language.
/// Generation attempts are ProviderCall rows (shot_id); the chosen output is selected_asset_id.
model Shot {
  id               String        @id @default(uuid(7)) @db.Uuid
  storyboardId     String        @map("storyboard_id") @db.Uuid
  sceneId          String        @map("scene_id") @db.Uuid
  sortOrder        Int           @map("sort_order")
  durationSec      Float         @map("duration_sec")
  /// The master-language narration this shot covers (anchor for timing).
  narrationAnchor  String?       @map("narration_anchor")
  visualType       VisualType    @map("visual_type")
  shotType         ShotType?     @map("shot_type")
  cameraMotion     CameraMotion? @map("camera_motion")
  /// ShotDirection contract: lens, composition, environment, period, characters, props, lighting, colour, action, continuity notes.
  direction        Json          @default("{}")
  /// Provider-neutral generation prompt (not tied to one vendor's name).
  generationPrompt String?       @map("generation_prompt")
  negativePrompt   String?       @map("negative_prompt")
  status           ShotStatus    @default(PLANNED)
  selectedAssetId  String?       @map("selected_asset_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  storyboard    Storyboard     @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  scene         Scene          @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  selectedAsset MediaAsset?    @relation(fields: [selectedAssetId], references: [id], onDelete: SetNull)
  generations   ProviderCall[]

  @@index([storyboardId, sortOrder])
  @@map("shots")
}

/// A deterministic data graphic. The AI proposes `spec` (InfographicSpec contract);
/// the renderer draws it. Never an AI-generated image.
model Infographic {
  id              String          @id @default(uuid(7)) @db.Uuid
  projectId       String          @map("project_id") @db.Uuid
  sceneId         String?         @map("scene_id") @db.Uuid
  infographicType InfographicType @map("infographic_type")
  title           String
  spec            Json
  status          ArtifactStatus  @default(DRAFT)
  /// Rendered output (master language).
  assetId         String?         @map("asset_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene   Scene?      @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  asset   MediaAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@map("infographics")
}

// ─────────────────────────────────────────────────────────────────────────────
// Edit, render, QA
// ─────────────────────────────────────────────────────────────────────────────

/// Edit decision list for one language. Narration timing is the backbone, so
/// timelines are per language while the shots they reference are shared.
model Timeline {
  id                String         @id @default(uuid(7)) @db.Uuid
  projectId         String         @map("project_id") @db.Uuid
  languageVersionId String         @map("language_version_id") @db.Uuid
  storyboardId      String?        @map("storyboard_id") @db.Uuid
  version           Int
  status            ArtifactStatus @default(DRAFT)
  durationMs        Int?           @map("duration_ms")
  /// Tracks: video, narration, music, ambience, SFX, graphics, subtitles. Contract defined in the editing milestone.
  tracks            Json           @default("{}")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  languageVersion LanguageVersion @relation(fields: [languageVersionId], references: [id], onDelete: Cascade)
  storyboard      Storyboard?     @relation(fields: [storyboardId], references: [id], onDelete: SetNull)
  renders         Render[]

  @@unique([languageVersionId, version])
  @@map("timelines")
}

model Render {
  id                String       @id @default(uuid(7)) @db.Uuid
  projectId         String       @map("project_id") @db.Uuid
  languageVersionId String       @map("language_version_id") @db.Uuid
  timelineId        String?      @map("timeline_id") @db.Uuid
  status            RenderStatus @default(QUEUED)
  provider          String
  isMock            Boolean      @default(false) @map("is_mock")
  /// Resolution, fps, codec, loudness target…
  settings          Json         @default("{}")
  outputAssetId     String?      @map("output_asset_id") @db.Uuid
  durationMs        Int?         @map("duration_ms")
  error             String?
  startedAt         DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  languageVersion LanguageVersion @relation(fields: [languageVersionId], references: [id], onDelete: Cascade)
  timeline        Timeline?       @relation(fields: [timelineId], references: [id], onDelete: SetNull)
  outputAsset     MediaAsset?     @relation(fields: [outputAssetId], references: [id], onDelete: SetNull)
  qaReports       QaReport[]
  approvals       Approval[]

  @@index([projectId])
  @@map("renders")
}

/// Automated QA output. Informs, never replaces, the human final approval.
model QaReport {
  id                String   @id @default(uuid(7)) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  languageVersionId String?  @map("language_version_id") @db.Uuid
  renderId          String?  @map("render_id") @db.Uuid
  overallScore      Int?     @map("overall_score")
  hasBlockingErrors Boolean  @default(false) @map("has_blocking_errors")
  /// QaFindings contract: overallScore, categoryScores, warnings, blockingErrors.
  findings          Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  languageVersion LanguageVersion? @relation(fields: [languageVersionId], references: [id], onDelete: SetNull)
  render          Render?          @relation(fields: [renderId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("qa_reports")
}

/// Writing Engine 2: house-style examples from the team's own approved scripts.
/// Proposed as CANDIDATEs (never fed back automatically); a person approves,
/// rejects or retires each. Approved ones join the corpus files in retrieval.
/// category, quality and source are the corpus vocabulary (WritingCorpusExample).
model WritingExample {
  id                   String               @id @default(uuid(7)) @db.Uuid
  /// Stable id across versions ("house-…"); with `version`, what a prompt was given.
  exampleId            String               @unique @map("example_id")
  version              Int                  @default(1)
  projectId            String?              @map("project_id") @db.Uuid
  scriptId             String?              @map("script_id") @db.Uuid
  scriptVersion        Int?                 @map("script_version")
  blockKey             String?              @map("block_key")
  text                 String
  /// sha256 of the normalized text: one candidate per wording.
  textHash             String               @unique @map("text_hash")
  category             String
  quality              String
  traits               String[]
  strengths            String[]
  weaknesses           String[]
  spokenRhythm         String               @map("spoken_rhythm")
  narrativeFunction    String               @map("narrative_function")
  whyItWorks           String?              @map("why_it_works")
  whyItFails           String?              @map("why_it_fails")
  sourceType           String               @map("source_type")
  sourceReference      String?              @map("source_reference")
  copyrightSafe        Boolean              @default(true) @map("copyright_safe")
  approvedForRetrieval Boolean              @default(false) @map("approved_for_retrieval")
  status               WritingExampleStatus @default(CANDIDATE)
  /// What the diagnostics measured when it was proposed (AI-pattern signals, rhythm).
  diagnostics          Json                 @default("{}")
  createdBy            String               @map("created_by")
  reviewedBy           String?              @map("reviewed_by")
  reviewedAt           DateTime?            @map("reviewed_at") @db.Timestamptz(3)
  reviewNote           String?              @map("review_note")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  script  Script?  @relation(fields: [scriptId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([projectId])
  @@map("writing_examples")
}
