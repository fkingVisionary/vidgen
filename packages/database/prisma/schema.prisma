// Documentary Engine — database schema (V1)
//
// Conventions
//  * Primary keys are UUIDv7 (time-ordered, index friendly).
//  * Tables and columns are snake_case in Postgres (@@map / @map).
//  * Money is Decimal(14,6) USD.
//  * Fields that are queried, filtered or joined on are real columns. Creative
//    payloads whose shape will still evolve (story sequences, shot direction,
//    infographic specs, timelines) are JSONB, validated in code by the zod
//    contracts in packages/core/src/contracts.
//  * Enums mirror packages/core/src/enums.ts. A unit test fails if they drift.
//
// Multilingual model
//  Project ─┬─ LanguageVersion (en = master, es, fr, …)
//           └─ Script (language-neutral structure) ── Scene ─┬─ SceneNarration (one per language)
//                                                            └─ Shot (language-neutral visuals, reused)
//  Research, story, storyboard, shots and most assets are shared by all
//  languages. Narration, subtitles, timeline, render and publishing are per
//  LanguageVersion.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

